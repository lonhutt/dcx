# goldens and fixtures are compared byte for byte; keeps autocrlf on Windows from
# rewriting them
testdata/** text eol=lf
src/**/testdata/** text eol=lf
RULES.md text eol=lf

# real-world configs keep whatever line endings upstream committed
testdata/corpus/*.jsonc -text

# position fixtures depend on their exact line endings (\n, \r\n, lone \r)
src/position/testdata/*.jsonc -text

# the pre-commit hook runs dcx.sh from a git clone, and it reads package.json with sed
scripts/*.sh text eol=lf
package.json text eol=lf
