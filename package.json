{
  "name": "dcx",
  "version": "0.1.0",
  "description": "A linter for devcontainer.json",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dcx": "dist/dcx.js"
  },
  "files": [
    "dist/dcx.js"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "build": "bun build ./index.ts --compile --minify --sourcemap --bytecode --outfile dist/dcx",
    "bundle": "bun build ./index.ts --target=bun --minify --outfile dist/dcx.js",
    "prepublishOnly": "bun run bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test"
  }
}
