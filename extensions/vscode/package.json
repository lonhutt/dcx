{
  "name": "dcx",
  "displayName": "dcx: devcontainer.json linter",
  "description": "Lints devcontainer.json as you type: typos, invalid values, and settings that don't fit the config's setup.",
  "version": "0.1.0",
  "publisher": "lonhutt",
  "license": "MIT",
  "repository": "https://github.com/lonhutt/dcx",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:jsonc",
    "workspaceContains:**/.devcontainer/devcontainer.json",
    "workspaceContains:**/.devcontainer/*/devcontainer.json",
    "workspaceContains:**/.devcontainer.json"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "dcx",
      "properties": {
        "dcx.enable": {
          "type": "boolean",
          "default": true,
          "description": "Lint devcontainer.json files."
        },
        "dcx.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "A local dcx checkout to run the language server from, with bun. Only for working on dcx itself."
        },
        "dcx.run": {
          "type": "string",
          "enum": [
            "onSave",
            "onType"
          ],
          "default": "onType",
          "description": "Lint when a file is saved, or as you type."
        },
        "dcx.online": {
          "type": "boolean",
          "default": false,
          "description": "Enable rules that need network access: feature options and extension availability. Left unset, .dcx.yaml or DCX_ONLINE decides."
        },
        "dcx.configPath": {
          "type": "string",
          "default": "",
          "description": "An explicit .dcx.yaml, absolute or relative to the workspace folder. Empty means discover it."
        },
        "dcx.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the dcx language server to the dcx output channel."
        }
      }
    },
    "commands": [
      {
        "command": "dcx.lintWorkspace",
        "title": "Lint Workspace",
        "category": "dcx"
      },
      {
        "command": "dcx.fixAll",
        "title": "Fix All Auto-fixable Problems",
        "category": "dcx"
      },
      {
        "command": "dcx.restartServer",
        "title": "Restart Server",
        "category": "dcx"
      },
      {
        "command": "dcx.showOutput",
        "title": "Show Output",
        "category": "dcx"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts src/server.ts --target=node --format=cjs --external vscode --minify --outdir dist",
    "test:e2e": "bun e2e/run.ts",
    "package": "bun run build && bunx @vscode/vsce@4.1.0 package --no-dependencies --skip-license"
  }
}
