{
    "name": "C# (.NET 8.0)",
    "dockerFile": "Dockerfile",
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {}
    },
    "forwardPorts": [
        6080
    ],
    "postCreateCommand": "dotnet restore",
    "customizations": {
        "vscode": {
            "settings": {
                "dotnet.defaultSolution": "CAFESharp.sln"
            },
            "extensions": [
                "ms-dotnettools.csharp"
            ]
        }
    }
}
