{
    "name": "KnightScribe Backend",

    "build": {
        "dockerfile": "../backend/Dockerfile",
        "context": ".."
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },

    "forwardPorts": [
        8000
    ],

    "remoteUser": "vscode"
}