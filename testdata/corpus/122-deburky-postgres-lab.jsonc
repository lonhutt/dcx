{
  // Dev container: Python 3.12 + uv, with the pg16/pgvector database as a sidecar.
  // "Reopen in Container" in VS Code, or `devcontainer up --workspace-folder .` with the CLI.
  "name": "sqlalchemy-pgvector",
  "dockerComposeFile": ["../docker/postgres-pgvector.yaml", "docker-compose.yml"],
  "service": "dev",
  "runServices": ["dev", "db"],
  "workspaceFolder": "/workspaces/postgres-lab",
  "shutdownAction": "stopCompose",

  "features": {
    // Talk to the host's Docker daemon from inside the container (the pgvector notebook's
    // Docker SDK lookup, `docker compose` for pgrust, kind). No Docker-in-Docker daemon needed.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "helm": "none", "minikube": "none" },
    // Node.js for py-pglite (the PGlite notebook runs Postgres in Node) and the three.js city in viz/
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    // the command runner behind the root justfile
    "ghcr.io/guiyomh/features/just:0": {}
  },

  // Inside the compose network the database is reachable as `db`, not `localhost`.
  // load_dotenv() never overrides variables that already exist, so these win over .env.
  "containerEnv": {
    "DATABASE_URL": "postgresql+psycopg://app:pwd@db:5432/app",
    "PYTHONPATH": "src",
    "UV_LINK_MODE": "copy"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "jupyter.kernels.excludePythonEnvironments": ["/usr/local/bin/python"]
      }
    }
  }
}
