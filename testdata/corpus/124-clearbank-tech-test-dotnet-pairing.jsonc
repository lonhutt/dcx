{
  "name": "Payment Engine (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/PaymentEngine",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "PaymentEngine.sln"
      }
    }
  },
  "postCreateCommand": "dotnet restore && dotnet build",
  "remoteUser": "vscode"
}
