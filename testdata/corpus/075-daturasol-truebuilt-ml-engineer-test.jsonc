{
    "name": "TrueBuild ML Dev",
    "dockerFile": "../docker/Dockerfile.dev",
    "context": "..",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=truebuild-venv,target=${containerWorkspaceFolder}/.venv,type=volume"
    ],
    "runArgs": [
        "--gpus",
        "all",
        "--shm-size",
        "8g"
    ],
    "containerEnv": {
        "PYTHONPATH": "/workspace/src",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1"
    },
    "postCreateCommand": "poetry install --with dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                // "ms-python.isort",
                "charliermarsh.ruff",
                "kevinrose.vsc-python-indent",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-keymap",
                "yzhang.markdown-all-in-one",
                "davidanson.vscode-markdownlint",
                "mermaidchart.vscode-mermaid-chart",
                "github.vscode-pull-request-github",
                "eamodio.gitlens",
                "tamasfe.even-better-toml",
                "tomoki1207.pdf"
            ],
            "settings": {
                // General Python
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.testing.pytestEnabled": true,
                // Formatting & On-Save Actions (Delegated entirely to Ruff for speed)
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports.ruff": "explicit",
                        "source.fixAll.ruff": "explicit"
                    }
                },
                // --- RUFF  ---
                "ruff.enable": true,
                "ruff.organizeImports": true,
                "ruff.fixAll": true,
                // Pylance — language server (Focused ONLY on Type Checking and Autocomplete)
                "python.languageServer": "Pylance",
                "python.analysis.venvPath": "/workspace",
                "python.analysis.venv": ".venv",
                "python.analysis.extraPaths": [
                    "/workspace/src"
                ],
                "python.analysis.diagnosticMode": "openFilesOnly",
                "python.analysis.typeCheckingMode": "standard",
                "python.analysis.displayEnglishDiagnostics": true,
                "python.analysis.disableTaggedHints": true,
                "python.analysis.enableTroubleshootMissingImports": true,
                // Pylance — completions and hints
                "python.analysis.autoImportCompletions": true,
                "python.analysis.autoFormatStrings": true,
                "python.analysis.completeFunctionParens": true,
                "python.analysis.showOnlyDirectDependenciesInAutoImport": true,
                "python.analysis.generateWithTypeAnnotation": true,
                // Pylance — inlay hints
                "python.analysis.inlayHints.callArgumentNames": "partial",
                "python.analysis.inlayHints.functionReturnTypes": true,
                "python.analysis.inlayHints.pytestParameters": true,
                // Pylance — strict type inference
                "python.analysis.typeEvaluation.strictDictionaryInference": true,
                "python.analysis.typeEvaluation.strictListInference": true,
                "python.analysis.typeEvaluation.strictSetInference": true,
                // Pylance — indexing (Fixed typo here)
                "python.analysis.indexing": false,
                "python.analysis.indexing.followSymlinkedFolders": false,
                // Turn off Pylance Linting - Let Ruff handle this instantly
                "python.analysis.reportUnusedParameter": "none",
                "python.analysis.reportUnusedFunction": "none",
                "python.analysis.reportUnusedVariable": "none",
                "python.analysis.reportUnusedImport": "none",
                "python.analysis.reportUnusedClass": "none",
                // Exclude heavy ML directories AND environment files from being analyzed
                "python.analysis.exclude": [
                    "**/data",
                    "**/models",
                    "**/.venv",
                    "**/__pycache__"
                ],
                // Jupyter
                "jupyter.runStartupCommands": [
                    "%load_ext autoreload",
                    "%autoreload 2"
                ]
            }
        }
    }
}